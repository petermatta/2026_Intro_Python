        "from pathlib import Path\n",
        "import numpy as np\n",
        "\n",
        "# Get the folder containing the downloaded Argo files\n",
        "folder = Path(files[0]).parent\n",
        "\n",
        "# Load each NumPy array from its corresponding .npy file\n",
        "T = np.load(folder / \"T.npy\")\n",
        "S = np.load(folder / \"S.npy\")\n",
        "P = np.load(folder / \"P.npy\")\n",
        "date = np.load(folder / \"date.npy\")\n",
        "lat = np.load(folder / \"lat.npy\")\n",
        "lon = np.load(folder / \"lon.npy\")\n",
        "level = np.load(folder / \"levels.npy\")\n",
        "# Pre-supplied: the conservative-temperature function from the gsw library\n",
        "%pip install gsw\n",
        "from gsw import CT_from_t\n",
        "# Compute conservative temperature from salinity, temperature, and pressure\n",
        "conservative_temp = CT_from_t(S, T, P)\n",
        "\n",
        "# Constants for the relative density formula\n",
        "a = 7.718e-1\n",
        "b = -8.44e-2\n",
        "c = -4.561e-3\n",
        "\n",
        "# Compute seawater density relative to pure water\n",
        "relative_density = a * S + b * conservative_temp + c * conservative_temp**2\n",
        "# Print the shape of the result\n",
        "print(relative_density.shape)\n",
        "\n",
        "# Check that the result has the same shape as T\n",
        "print(relative_density.shape == T.shape)\n",
        "# Calculate the mean at each depth across all profiles\n",
        "T_mean = np.mean(T, axis=0)\n",
        "S_mean = np.mean(S, axis=0)\n",
        "P_mean = np.mean(P, axis=0)\n",
        "relative_density_mean = np.mean(relative_density, axis=0)\n",
        "\n",
        "# Calculate the standard deviation at each depth across all profiles\n",
        "T_std = np.std(T, axis=0)\n",
        "S_std = np.std(S, axis=0)\n",
        "P_std = np.std(P, axis=0)\n",
        "relative_density_std = np.std(relative_density, axis=0)\n",
        "# Count the missing values in T\n",
        "n_missing = np.isnan(T).sum()\n",
        "\n",
        "# Calculate the percentage of missing values\n",
        "missing_percentage = n_missing / T.size * 100\n",
        "\n",
        "\n",
        "# Recompute the means at each depth, ignoring NaN values\n",
